# Copy to .env (or run ./setup.sh, which generates the secrets for you).

# --- Model -----------------------------------------------------------------
# Any model you `ollama pull` locally. Must support tool/function calling:
# qwen2.5, llama3.1, mistral-nemo, firefunction-v2, etc.
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Sandbox Manager -------------------------------------------------------
# Shared secret between the api and sandbox-manager services. REQUIRED —
# both services refuse to start without it. Generate with:
#   openssl rand -hex 32
MANAGER_TOKEN=

# GID that owns /var/run/docker.sock, so the manager reads it via group
# membership instead of running as root. ./setup.sh detects this for you.
DOCKER_GID=999

# The manager's Unix socket is a host bind mount (not a Docker-managed named
# volume), running as this uid:gid — so something outside Docker entirely
# (e.g. an SSH-tunneled remote client; see macos/README.md's remote-hosting
# setup) can connect to it directly. ./setup.sh fills these in from `id -u`/
# `id -g` and defaults the path to ./sandbox-manager-run.
MANAGER_SOCKET_UID=1000
MANAGER_SOCKET_GID=1000
MANAGER_SOCKET_HOST_DIR=./sandbox-manager-run

# --- Isolation backend -----------------------------------------------------
# Set on the MANAGER, not the api — the API does not choose its own isolation.
#   docker      = shared-kernel container (default; right for local single-user)
#   firecracker = per-task microVM (needs /dev/kvm + host setup; docs/FIRECRACKER.md)
SANDBOX_BACKEND=docker

# Per-VM limits, firecracker backend only
FIRECRACKER_VCPUS=2
FIRECRACKER_MEM_MIB=2048
FIRECRACKER_BOOT_TIMEOUT=60
FIRECRACKER_USE_JAILER=true

# --- Task budgets (fix 2) --------------------------------------------------
TASK_MAX_ITERATIONS=40
TASK_MAX_SECONDS=1800
TASK_MAX_TOKENS=200000
MODEL_TIMEOUT_SECONDS=600

# --- Per-task sandboxes (fix 1) -------------------------------------------
SANDBOX_PORT_BASE=6100
SANDBOX_PORT_COUNT=32
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPU_LIMIT=2
SANDBOX_PIDS_LIMIT=512
# Must match `docker volume ls | grep workspace` — compose prefixes volume
# names with the project directory name.
WORKSPACE_VOLUME=shellhouse_workspace

# --- Vision (fix 3) -------------------------------------------------------
# Screenshots are fed to the model as images only when the model name matches
# one of these substrings. Pull a vision model to enable it, e.g.:
#   docker exec agent-ollama ollama pull qwen2.5vl:7b
VISION_MODEL_HINTS=vl,vision,llava,bakllava,moondream,minicpm-v,gemma3,qwen2.5vl

# --- Queue / workers (durability) -----------------------------------------
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3

# --- Memory (Phase 4) ------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=5
AUTO_EVIDENCE=true
# Pull once: docker exec agent-ollama ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Secrets (Phase 5) ----------------------------------------------------
# Encrypts stored credentials. Leave EMPTY to disable credential storage
# entirely (the safest default until you need it). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if you change this key, previously stored secrets become
# unrecoverable and must be re-added.
SECRETS_KEY=

# --- MCP (Phase 6) --------------------------------------------------------
MCP_ENABLED=true
# Servers are configured in /data/mcp_servers.json inside the api volume.
# See mcp_servers.example.json. All MCP tools require approval by default.

# Optional: allow passwordless sudo for `box` inside sandboxes (weakens
# isolation: drops no-new-privileges, restores some root capabilities).
# Existing containers must be recreated (and the image rebuilt) to pick it up.
# SANDBOX_ALLOW_SUDO=1
# SANDBOX_NO_NEW_PRIVS=false   # only for the compose-managed shared sandbox

# Optional: group relay for friends (compose profile "relay"). See group-relay/README.md.
# RELAY_BIND=192.0.2.10          # host address on the network friends use (default: loopback only)
# RELAY_PORT=8443
# RELAY_REGISTRATION_TOKEN=      # if set, new users must present it to register (openssl rand -hex 16)
# RELAY_MAX_HUMANS=20
