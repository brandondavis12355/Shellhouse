# Generated, machine-specific or secret: a fresh clone rebuilds or recreates
# all of it.

# Seed data for the sandbox VM's /home/box and /workspace. May contain real
# credentials, session state or business data. Never commit it.
/box/
/workspace/

# Secrets and runtime state
.env
sandbox-manager-run/
group-relay/certs/
*.db
*.sqlite
# Per-developer signing team, included by macos/Signing.xcconfig
macos/Signing.local.xcconfig

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
# Generated from macos/project.yml by XcodeGen (`xcodegen generate`); it also holds
# each developer's own signing team, so it must not be shared.
*.xcodeproj/
*.xcworkspace/
# SwiftPM's resolved versions; recreated on the first build.
Package.resolved

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (web/ tooling, if used)
node_modules/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local run output
*.log
/baseline.json
