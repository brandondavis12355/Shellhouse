# Everything here is generated or machine-specific: a fresh clone rebuilds it.

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
# Generated from macos/project.yml by XcodeGen (`xcodegen generate`); it also holds
# each developer's own signing team, so it must not be shared.
*.xcodeproj/
*.xcworkspace/
# SwiftPM's resolved versions; recreated on the first build.
Package.resolved

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (web/ tooling, if used)
node_modules/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local run output
*.log
/baseline.json
