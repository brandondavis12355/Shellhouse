{
  "_comment": [
    "Reference VM shape, for booting a VM by hand while debugging:",
    "  firecracker --api-sock /tmp/fc.sock --config-file vm-template.json",
    "The provider configures VMs through the API socket instead of this file,",
    "but the values here must stay in sync with FirecrackerSandboxProvider."
  ],
  "boot-source": {
    "kernel_image_path": "/var/lib/agent-vm/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off init=/sbin/init random.trust_cpu=on"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/agent-vm/instances/debug.ext4",
      "is_root_device": true,
      "is_read_only": false,
      "rate_limiter": {
        "bandwidth": { "size": 104857600, "refill_time": 1000 },
        "ops": { "size": 2000, "refill_time": 1000 }
      }
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false,
    "track_dirty_pages": true
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "02:FC:00:00:00:01",
      "host_dev_name": "fctap1",
      "rx_rate_limiter": { "bandwidth": { "size": 25000000, "refill_time": 1000 } },
      "tx_rate_limiter": { "bandwidth": { "size": 25000000, "refill_time": 1000 } }
    }
  ],
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/var/run/agent-vm/debug.vsock"
  },
  "balloon": {
    "amount_mib": 0,
    "deflate_on_oom": true,
    "stats_polling_interval_s": 5
  },
  "logger": {
    "log_path": "/var/log/agent-vm/debug.log",
    "level": "Warning",
    "show_level": true,
    "show_log_origin": true
  }
}
